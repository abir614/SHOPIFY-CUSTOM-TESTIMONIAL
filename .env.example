# FormHub — Environment Variables
# Copy this file to .env and fill in the values before running.

# ---------------------------------------------------------------------------
# REQUIRED — the app will refuse to start without these
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (SRV format with database name and appName)
MONGODB_URI=mongodb+srv://user:pass@formhub.oyts1uz.mongodb.net/formhub?appName=FormHub

# Long random string used to sign JWTs — change this in production!
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-openssl-rand-hex-32

# 32-byte base64-encoded key for AES-GCM encryption of Shopify tokens / Turnstile secrets
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-in-production-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults are shown
# ---------------------------------------------------------------------------

# HTTP server port and bind address
PORT=8080
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the auth/dashboard API.
# Use * to allow any origin (default, convenient for development).
DASHBOARD_ALLOWED_ORIGINS=*
