# FormHub — Environment Variables
# Copy this file to .env and fill in the values before running.

# ---------------------------------------------------------------------------
# REQUIRED — the app will refuse to start without these
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (or any MongoDB-compatible URI)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (default: formhub)
MONGODB_DB_NAME=formhub

# Long random string used to sign JWTs — change this in production!
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-openssl-rand-hex-32

# 32-byte base64-encoded key for AES-GCM encryption of Shopify tokens / Turnstile secrets
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-in-production-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults are shown
# ---------------------------------------------------------------------------

# HTTP server port and bind address
PORT=3000
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the auth/dashboard API.
# Use * to allow any origin (default, convenient for development).
DASHBOARD_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# FILE STORAGE — choose one backend
# ---------------------------------------------------------------------------

# "local"  — store uploaded files on disk (good for single-server deployments)
# "s3"     — store in an S3-compatible bucket (recommended for production)
FILE_STORAGE=local

# Directory for local file uploads (used when FILE_STORAGE=local)
UPLOAD_DIR=./uploads

# S3 / S3-compatible settings (used when FILE_STORAGE=s3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://your-s3-compatible-endpoint  # optional, for MinIO / R2 etc.
