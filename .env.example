# --- Required ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call this API from a browser.
# Use "*" only for local testing — never in production.
ALLOWED_ORIGINS=https://your-storefront.myshopify.com,https://your-custom-domain.com

# --- Turnstile (Cloudflare CAPTCHA) ---
# Leave unset + ALLOW_UNVERIFIED_SUBMISSIONS unset/false in production:
# the server will reject every submission until this is configured.
TURNSTILE_SECRET_KEY=
# Set to "true" ONLY for local development to bypass Turnstile entirely.
ALLOW_UNVERIFIED_SUBMISSIONS=false

# --- Server ---
PORT=8787
# Express "trust proxy" setting. Use "loopback" if running directly on the
# public internet with no reverse proxy in front. If deployed behind
# Cloudflare / Nginx / a load balancer, set this to the number of trusted
# hops (e.g. "1") or a specific proxy IP/CIDR — see Express docs for
# `trust proxy`. This controls how `req.ip` is derived from
# X-Forwarded-For; it does NOT affect CF-Connecting-IP handling, which is
# read directly regardless (only trust it if you actually sit behind
# Cloudflare).
TRUST_PROXY=loopback

# --- Timeouts (ms) ---
SHOPIFY_TIMEOUT_MS=10000
TURNSTILE_TIMEOUT_MS=5000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
