# Comma-separated exact origins allowed to call this API from a browser.
# Do NOT use "*" in production — list your actual storefront domain(s).
ALLOWED_ORIGINS=https://your-store.myshopify.com,https://www.your-domain.com

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Requests allowed per IP per window on the POST endpoint
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

NODE_ENV=production
PORT=8080
